# ─── Server Configuration ──────────────────────────────────────────
PORT=8000
FLASK_ENV=production
ALLOWED_ORIGINS=*

# ─── PostgreSQL Database (Production Cloud or Local) ───────────────
# Option A: Full Connection URI (Neon, Supabase, Render, Railway, AWS RDS)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/mobility_db?sslmode=require

# Option B: Discrete Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password

# ─── Payment Gateway (Razorpay) ────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# ─── SMS Notification (Fast2SMS) ───────────────────────────────────
FAST2SMS_API_KEY=your_fast2sms_api_key

# ─── Maps & Navigation ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
